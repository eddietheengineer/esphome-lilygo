# Template for secrets.yaml.
#
# Copy this file to `secrets.yaml` and fill in real values:
#   cp secrets.yaml.example secrets.yaml
#
# `secrets.yaml` is gitignored — never commit real credentials.

# --- Tailscale -------------------------------------------------------------
# One-time auth key to register the node on your tailnet.
# Create at: https://login.tailscale.com/admin/settings/keys
# (Recommended: Reusable = on, Ephemeral = off, Pre-approved = on, Expiration = 90d)
tailscale_auth_key: "tskey-auth-<PASTE-YOUR-AUTH-KEY>"
# The device's Tailscale IP (100.x.y.z) — used for OTA over the tailnet.
# Find it in the Tailscale admin console or the device's boot log.
tailscale_ip: "100.x.y.z"
# The Home Assistant node's Tailscale IP (100.x.y.z) — pinned as the
# priority peer so WireGuard sessions open to HA first.
priority_peer_ip: "100.x.y.z"

# --- Cellular (SIM7670G) ---------------------------------------------------
# APN for your carrier's data service ("internet" works for most carriers).
modem_apn: "internet"
# SIM PIN (leave empty if the SIM is not PIN-locked).
modem_sim_pin: ""
# PPP CHAP username/password (leave empty for IMSI-based auth).
modem_ppp_user: ""
modem_ppp_pass: ""

# --- Local Wi-Fi uplink (ESP32-S3's own radio) ----------------------------
# A local network with internet access. Serves as the fallback uplink and the
# "network" component the api component requires.
wifi_ssid: "<YOUR-WIFI-SSID>"
wifi_password: "<YOUR-WIFI-PASSWORD>"

# --- Home Assistant API -----------------------------------------------------
# The API encryption key (from the ESPHome device entry in Home Assistant).
api_key: "<YOUR-HA-API-KEY>"

# --- MQTT (t-sim7670g-s3-mqtt.yaml) ---------------------------------------
# The MQTT broker the device publishes to. It must be reachable from the
# public internet (the device is behind carrier NAT) - e.g. a small Mosquitto
# on a VPS (see README "MQTT uplink variant") or a cloud broker.
mqtt_broker: "<YOUR-VPS-IP-OR-DOMAIN>"
mqtt_username: "esphome"
mqtt_password: "<YOUR-MQTT-PASSWORD>"
# CA certificate for the broker (the device config uses TLS by default).
# Copy mosquitto/certs/ca.crt next to the .yaml as mosquitto-ca.pem, then set
# this to the file path (relative to the .yaml, or absolute).
mqtt_ca_cert: "mosquitto-ca.pem"
# Note: the 'homeassistant' broker user (created by gen-certs.sh arg 4) is
# for Home Assistant's MQTT integration, not for the device.
